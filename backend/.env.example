# NovelOS 后端环境变量示例：复制为 .env 后按需修改

# AI Provider：deepseek | offline
# deepseek = 真实调用 DeepSeek Flash API；offline = 离线规则提供者（无网络/无密钥时用于测试与降级）
NOVELOS_AI_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 数据与正文目录
NOVELOS_DATA_DIR=D:/Projects/NovelOS/data
NOVELOS_DB_PATH=D:/Projects/NovelOS/data/novelos.db

# CORS（前端 dev server）
NOVELOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

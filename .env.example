# New control platform deployment. Copy to .env; never commit the filled file.
NOVELOS_ENV=production
NOVELOS_DOMAIN=novelos.example.com
NOVELOS_PUBLIC_ORIGIN=https://novelos.example.com

# Set a strong database password. The application encodes it safely in its URL.
POSTGRES_PASSWORD=

# Generate with: python -m app.platform.cli generate-key (from backend/).
# Preserve this key separately with your backups; changing it prevents decryption.
NOVELOS_MASTER_KEY=

# For localhost-only development use:
# NOVELOS_ENV=development
# NOVELOS_PUBLIC_ORIGIN=http://localhost:3000
# The legacy backend/.env is not automatically loaded by the new platform.

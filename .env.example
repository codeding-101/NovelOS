# docker compose 用的环境变量模板：复制成 .env 放在仓库根目录（.env 不入版本库）
#
#   cp .env.example .env
#
# 全都不填也能起：后端会自动降级到离线规则提供者（不会调用任何外部模型），
# 界面上会把这次降级当 warning 说出来。要真实生成质量，填 DEEPSEEK_API_KEY。

# 用哪个提供者：deepseek | offline | 你自己在 NOVELOS_PROVIDERS 里注册的名字
NOVELOS_AI_PROVIDER=deepseek

# DeepSeek（默认模型）。留空则走离线提供者。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 任何 OpenAI 兼容端点都可以挂进来（本地 Ollama、vLLM、公司网关……），
# 形如 [{"name":"local","base_url":"http://host.docker.internal:11434/v1","model":"qwen2.5:14b","api_key":"none"}]
# 注意容器里的 localhost 是容器自己，要用 host.docker.internal 指回宿主机。
NOVELOS_PROVIDERS=[]

# 允许跨域的前端地址（前端已经在服务端转发 /api，所以通常用不到）
NOVELOS_CORS_ORIGINS=http://localhost:3000
